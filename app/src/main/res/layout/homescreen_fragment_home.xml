                                android:layout_height="150dp"
                                android:src="@drawable/image_vung_tau" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Nhà bên hồ"
                                android:textSize="16sp"
                                android:textColor="#000000" />

                            <!-- Số sao -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="★★★★☆"
                                android:textSize="14sp"
                                android:textColor="#FFA000" />

                            <!-- Nhận xét -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="8.5/10"
                                android:textSize="14sp"
                                android:textColor="#000000" />

                            <!-- Tình trạng phòng -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Còn phòng"
                                android:textSize="14sp"
                                android:textColor="#4CAF50" />

                            <!-- Ngày nhận và trả phòng -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Nhận: 25/10/2024, Trả: 28/10/2024"
                                android:textSize="14sp"
                                android:textColor="#000000" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="8dp"
                            android:gravity="center"
                            android:layout_marginEnd="16dp">

                            <ImageView
                                android:layout_width="233dp"
                                android:layout_height="150dp"
                                android:src="@drawable/image_phan_thiet" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tam An Hotel"
                                android:textSize="16sp"
                                android:textColor="#000000" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="★★★☆☆"
                                android:textSize="14sp"
                                android:textColor="#FFA000" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="7.0/10"
                                android:textSize="14sp"
                                android:textColor="#000000" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Hết phòng"
                                android:textSize="14sp"
                                android:textColor="#F44336" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Nhận: 26/10/2024, Trả: 30/10/2024"
                                android:textSize="14sp"
                                android:textColor="#000000" />
                        </LinearLayout>

                    </LinearLayout>
                </HorizontalScrollView>

            </RelativeLayout>



            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/home_nearbyhotels"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="List hotels"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:textSize="20sp"
                    android:layout_marginLeft="10dp">

                </TextView>
                <!--                    <TextView-->
                <!--                        android:layout_width="wrap_content"-->
                <!--                        android:layout_height="wrap_content"-->
                <!--                        android:text="See all"-->
                <!--                        android:textStyle="bold"-->
                <!--                        android:textColor="#06B3C4"-->
                <!--                        android:textSize="15sp"-->
                <!--                        android:layout_marginRight="10dp">-->

                <!--                    </TextView>-->
            </LinearLayout>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ProgressBar
                    android:id="@+id/progressBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"/>
                <LinearLayout
                    android:id="@+id/home_lvNearbyHotel"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="8dp"
                        android:gravity="center"

                        android:layout_marginEnd="16dp">

                        <ImageView
                            android:layout_width="233dp"
                            android:layout_height="150dp"
                            android:src="@drawable/image_vung_tau_uu_hotel" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Bùi Viện Hotel"
                            android:textSize="16sp"
                            android:textColor="#000000" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="★★★★☆"
                            android:textSize="14sp"
                            android:textColor="#FFA000" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="8.0/10"
                            android:textSize="14sp"
                            android:textColor="#000000" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Còn phòng"
                            android:textSize="14sp"
                            android:textColor="#4CAF50" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Nhận: 20/10/2024, Trả: 23/10/2024"
                            android:textSize="14sp"
                            android:textColor="#000000" />
                    </LinearLayout>

                    <!-- Hotel 4: Phan Thiết Hotel -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="8dp"
                        android:gravity="center"
                        android:layout_marginEnd="16dp">

                        <ImageView
                            android:layout_width="233dp"
                            android:layout_height="150dp"
                            android:src="@drawable/image_hotel_phan_thiet" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Phan Thiết Hotel"
                            android:textSize="16sp"
                            android:textColor="#000000" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="★★★★★"
                            android:textSize="14sp"
                            android:textColor="#FFA000" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="9.2/10"
                            android:textSize="14sp"
                            android:textColor="#000000" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Còn phòng"
                            android:textSize="14sp"
                            android:textColor="#4CAF50" />


                    </LinearLayout>

                    <!-- Hotel 5: Vũng Tàu Hotel -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="8dp"
                        android:gravity="center"
                        android:layout_marginEnd="16dp">

                        <ImageView
                            android:layout_width="233dp"
                            android:layout_height="169dp"
                            android:src="@drawable/image_vung_tau" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Vũng Tàu Hotel"
                            android:textSize="16sp"
                            android:textColor="#000000" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="★★☆☆☆"
                            android:textSize="14sp"
                            android:textColor="#FFA000" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="6.5/10"
                            android:textSize="14sp"
                            android:textColor="#000000" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Hết phòng"
                            android:textSize="14sp"
                            android:textColor="#F44336" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="8dp"
                        android:gravity="center"
                        android:layout_marginEnd="16dp">

                        <ImageView
                            android:layout_width="233dp"
                            android:layout_height="150dp"
                            android:src="@drawable/image_vung_tau" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sửa lại nhà bên hồ"
                            android:textSize="16sp"
                            android:textColor="#000000" />

                        <!-- Số sao -->
                        <TextView
                            android:layout_width="wrap_content"
